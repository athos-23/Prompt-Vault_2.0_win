<Application x:Class="PromptVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="BackgroundColor" Color="#161618"/>
        <SolidColorBrush x:Key="SidebarColor" Color="#1E1E22"/>
        <SolidColorBrush x:Key="CardColor" Color="#25252A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333338"/>
        <SolidColorBrush x:Key="AccentColor" Color="#6366F1"/>

    </Application.Resources>

</Application>
