<Window x:Class="PromptVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Vault"
        Width="1200"
        Height="700"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->

        <Border Grid.Column="1"
        Background="{StaticResource BackgroundColor}"
        Padding="30">


    <StackPanel>


        <TextBlock Text="Editor Prompt"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <TextBlock Text="Titolo"
                   Foreground="Gray"/>

        <TextBox Text="{Binding SelectedPrompt.Title}"
                 Background="{StaticResource CardColor}"
                 Foreground="White"
                 Margin="0,5,0,15"
                 Height="35"/>


        <TextBlock Text="Progetto"
                   Foreground="Gray"/>

        <TextBox Text="{Binding SelectedPrompt.Project}"
                 Background="{StaticResource CardColor}"
                 Foreground="White"
                 Margin="0,5,0,15"
                 Height="35"/>


        <TextBlock Text="Tag"
                   Foreground="Gray"/>

        <TextBox Text="{Binding SelectedPrompt.Tags}"
                 Background="{StaticResource CardColor}"
                 Foreground="White"
                 Margin="0,5,0,15"
                 Height="35"/>


        <TextBlock Text="Prompt"
                   Foreground="Gray"/>


        <TextBox Text="{Binding SelectedPrompt.Content}"
                 Background="{StaticResource CardColor}"
                 Foreground="White"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="250"
                 Margin="0,5,0,15"/>


        <Button Content="📋 Copia Prompt"
                Width="150"
                Height="35"
                Background="{StaticResource AccentColor}"
                Foreground="White"/>


    </StackPanel>


</Border>

        </DataTemplate>

    </ListBox.ItemTemplate>

</ListBox>

                    <TextBlock Text="📁 Scrittura"
                               Foreground="White"
                               Margin="20,5"/>

                    <TextBlock Text="📁 AI"
                               Foreground="White"
                               Margin="20,5"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- SEARCH -->

            <Border Background="{StaticResource SidebarColor}">

                <TextBox Width="350"
                         Height="35"
                         HorizontalAlignment="Left"
                         Margin="20"
                         Background="{StaticResource CardColor}"
                         Foreground="White"
                         BorderBrush="{StaticResource BorderColor}"
                         Text="Cerca prompt..."/>

            </Border>


            <!-- CONTENT -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">

                    <TextBlock Text="Nessun prompt"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>



                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundColor}">

                    <TextBlock Text="Seleziona un prompt o creane uno nuovo"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"/>

                </Border>


            </Grid>

        </Grid>


    </Grid>

</Window>
