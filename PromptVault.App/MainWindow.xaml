<Window x:Class="PromptVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Vault"
        Width="1400"
        Height="800"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0">

            <StackPanel>

                <TextBlock Text="⚡ Prompt Vault"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="20"/>

                <Button Content="+ Nuovo Prompt"
                        Command="{Binding NewPromptCommand}"
                        Margin="15"
                        Height="40"
                        Background="{StaticResource AccentColor}"
                        Foreground="White"/>

                <Separator Margin="15"/>

                <TextBlock Text="PROGETTI"
                           Foreground="Gray"
                           Margin="20,10,20,5"
                           FontWeight="Bold"/>

                <TextBlock Text="📁 Tutti i Prompt"
                           Foreground="White"
                           Margin="20,5"/>

            </StackPanel>

        </Border>

        <!-- LISTA PROMPT -->

        <Border Grid.Column="1"
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <TextBox DockPanel.Dock="Top"
                         Margin="10"
                         Height="35"
                         Background="{StaticResource CardColor}"
                         Foreground="White"
                         BorderBrush="{StaticResource BorderColor}"
                         Text="Cerca..."/>

                <ListBox ItemsSource="{Binding Prompts}"
                         SelectedItem="{Binding SelectedPrompt}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="10">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#25252A"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <TextBlock Text="{Binding Project}"
                                               Foreground="Gray"
                                               FontSize="11"/>

                                    <TextBlock Text="{Binding Content}"
                                               Margin="0,6,0,0"
                                               Foreground="#CCCCCC"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>

        </Border>

        <!-- EDITOR -->

        <Border Grid.Column="2"
                Background="{StaticResource BackgroundColor}"
                Padding="25">

            <StackPanel>

                <TextBlock Text="Titolo"
                           Foreground="Gray"/>

                <TextBox Text="{Binding SelectedPrompt.Title}"
                         Margin="0,5,0,15"
                         Height="35"
                         Background="{StaticResource CardColor}"
                         Foreground="White"/>

                <TextBlock Text="Progetto"
                           Foreground="Gray"/>

                <TextBox Text="{Binding SelectedPrompt.Project}"
                         Margin="0,5,0,15"
                         Height="35"
                         Background="{StaticResource CardColor}"
                         Foreground="White"/>

                <TextBlock Text="Tag"
                           Foreground="Gray"/>

                <TextBox Text="{Binding SelectedPrompt.Tags}"
                         Margin="0,5,0,15"
                         Height="35"
                         Background="{StaticResource CardColor}"
                         Foreground="White"/>

                <TextBlock Text="Prompt"
                           Foreground="Gray"/>

                <TextBox Text="{Binding SelectedPrompt.Content}"
                         Margin="0,5,0,20"
                         Height="400"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Background="{StaticResource CardColor}"
                         Foreground="White"/>

                <Button Content="📋 Copia Prompt"
                        Width="160"
                        Height="40"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentColor}"
                        Foreground="White"/>

            </StackPanel>

        </Border>

    </Grid>

