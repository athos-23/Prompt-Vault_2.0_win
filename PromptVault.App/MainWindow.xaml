                 Margin="0,5,0,15"/>


        <Button Content="📋 Copia Prompt"
                Width="150"
                Height="35"
                Background="{StaticResource AccentColor}"
                Foreground="White"/>


    </StackPanel>


</Border>

        </DataTemplate>

    </ListBox.ItemTemplate>

</ListBox>

                    <TextBlock Text="📁 Scrittura"
                               Foreground="White"
                               Margin="20,5"/>

                    <TextBlock Text="📁 AI"
                               Foreground="White"
                               Margin="20,5"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- SEARCH -->

            <Border Background="{StaticResource SidebarColor}">

                <TextBox Width="350"
                         Height="35"
                         HorizontalAlignment="Left"
                         Margin="20"
                         Background="{StaticResource CardColor}"
                         Foreground="White"
                         BorderBrush="{StaticResource BorderColor}"
                         Text="Cerca prompt..."/>

            </Border>


            <!-- CONTENT -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">

                    <TextBlock Text="Nessun prompt"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>



                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundColor}">

                    <TextBlock Text="Seleziona un prompt o creane uno nuovo"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"/>

                </Border>


            </Grid>

        </Grid>


    </Grid>

</Window>
