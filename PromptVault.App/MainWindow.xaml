<Window x:Class="PromptVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Vault"
        Width="1200"
        Height="700"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <StackPanel>

                    <TextBlock Text="⚡ Prompt Vault"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="20"/>


                    <Button Content="+ Nuovo Prompt"
                            Margin="15"
                            Height="35"
                            Background="{StaticResource AccentColor}"
                            Foreground="White"/>


                    <TextBlock Text="PROGETTI"
                               Foreground="Gray"
                               Margin="20,30,20,10"
                               FontSize="11"/>


                    <TextBlock Text="📁 Coding"
                               Foreground="White"
                               Margin="20,5"/>

                    <TextBlock Text="📁 Scrittura"
                               Foreground="White"
                               Margin="20,5"/>

                    <TextBlock Text="📁 AI"
                               Foreground="White"
                               Margin="20,5"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- SEARCH -->

            <Border Background="{StaticResource SidebarColor}">

                <TextBox Width="350"
                         Height="35"
                         HorizontalAlignment="Left"
                         Margin="20"
                         Background="{StaticResource CardColor}"
                         Foreground="White"
                         BorderBrush="{StaticResource BorderColor}"
                         Text="Cerca prompt..."/>

            </Border>


            <!-- CONTENT -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">

                    <TextBlock Text="Nessun prompt"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>



                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundColor}">

                    <TextBlock Text="Seleziona un prompt o creane uno nuovo"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"/>

                </Border>


            </Grid>

        </Grid>


    </Grid>

</Window>
